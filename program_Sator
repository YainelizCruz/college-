public class Sator {
    public static void main(String[] args) {
        char[][] matriz = {
                {'S', 'A', 'T', 'O', 'R'},
                {'A', 'R', 'E', 'P', 'O'},
                {'T', 'E', 'N', 'E', 'T'},
                {'O', 'P', 'E', 'R', 'A'},
                {'R', 'O', 'T', 'A', 'S'}};

        for(int i=0; i<5; i++){
            for(int j=0; j<5; j++){
                System.out.print(matriz[i][j]);
            }
            System.out.println();
        }
        System.out.println("La palabra SATOR se encuentra en las siquientes posiciones: ");

        for (int i=0; i<5; i++) {
            for (int j=0; j<5; j++) {
                //izquierda a derecha
                if (j+4<5 &&
                        matriz[i][j]=='S' &&
                        matriz[i][j+1]=='A' &&
                        matriz[i][j+2]=='T' &&
                        matriz[i][j+3]=='O' &&
                        matriz[i][j+4]=='R') {
                    System.out.println("Hacia la derecha desde la posición: (" + i + "," + j + ")");
                }
                //derecha a izquierda
                if (j-4>=0 &&
                        matriz[i][j] == 'S' &&
                        matriz[i][j-1] == 'A' &&
                        matriz[i][j-2] == 'T' &&
                        matriz[i][j-3] == 'O' &&
                        matriz[i][j-4] == 'R') {
                    System.out.println("Hacia la izquierda desde la posición: (" + i + "," + j + ")");
                }
                //arriba a abajo
                if (i+4<5 &&
                        matriz[i][j] == 'S' &&
                        matriz[i+1][j] == 'A' &&
                        matriz[i+2][j] == 'T' &&
                        matriz[i+3][j] == 'O' &&
                        matriz[i+4][j] == 'R') {
                    System.out.println("Hacia abajo desde la posición: (" + i + "," + j + ")");
                }
                //abajo a arriba
                if (i-4>=0 &&
                        matriz[i][j] == 'S' &&
                        matriz[i-1][j] == 'A' &&
                        matriz[i-2][j] == 'T' &&
                        matriz[i-3][j] == 'O' &&
                        matriz[i-4][j] == 'R') {
                    System.out.println("Hacia arriba desde la posición: (" + i + "," + j + ")");
                }
                //diagonal abajo a derecha
                if (i+4<5 && j+4<5 &&
                        matriz[i][j] == 'S' &&
                        matriz[i+1][j+1] == 'A' &&
                        matriz[i+2][j+2] == 'T' &&
                        matriz[i+3][j+3] == 'O' &&
                        matriz[i+4][j+4] == 'R') {
                    System.out.println("Hacia la derecha-abajo en diagonal desde la posición: (" + i + "," + j + ")");
                }

                //diagonal arriba a izquierda
                if (i-4>=0 && j-4>=0 &&
                        matriz[i][j] == 'S' &&
                        matriz[i-1][j-1] == 'A' &&
                        matriz[i-2][j-2] == 'T' &&
                        matriz[i-3][j-3] == 'O' &&
                        matriz[i-4][j-4] == 'R') {
                    System.out.println("Hacia arriba-izquierda en diagonal desde la posición: (" + i + "," + j + ")");
                }

                //diagonal abajo a izquierda
                if (i+4<5 && j-4>=0 &&
                        matriz[i][j] == 'S' &&
                        matriz[i+1][j-1] == 'A' &&
                        matriz[i+2][j-2] == 'T' &&
                        matriz[i+3][j-3] == 'O' &&
                        matriz[i+4][j-4] == 'R') {
                    System.out.println("Hacia abajo-izquierda en diagonal desde la posición: (" + i + "," + j + ")");
                }

                //diagonal arriba a derecha
                if (i-4>=0 && j+4<5 &&
                        matriz[i][j] == 'S' &&
                        matriz[i-1][j+1] == 'A' &&
                        matriz[i-2][j+2] == 'T' &&
                        matriz[i-3][j+3] == 'O' &&
                        matriz[i-4][j+4] == 'R') {
                    System.out.println("Hacia arriba-derecha en diagonal desde la posición: (" + i + "," + j + ")");
                }
            }
        }
    }
}
